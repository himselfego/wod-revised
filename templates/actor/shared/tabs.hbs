<nav class="wod-tabs tabs" data-group="sheet">
  {{#each sheetTabs as |tab|}}
  <button
    class="wod-tabs__tab {{tab.cssClass}}"
    type="button"
    data-action="tab"
    data-group="{{tab.group}}"
    data-tab="{{tab.id}}"
  ><i class="{{tab.icon}}" aria-hidden="true"></i>{{tab.label}}</button>
  {{/each}}
  {{#if editable}}
  <button
    class="wod-tabs__settings"
    type="button"
    data-action="sheetSettings"
    data-tooltip="WOD.Action.sheetSettings"
    aria-label="{{localize "WOD.Action.sheetSettings"}}"
  ><i class="fa-solid fa-gear" aria-hidden="true"></i></button>
  {{/if}}
</nav>
